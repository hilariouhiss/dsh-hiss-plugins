{
  "name": "@hilariouhiss/dsh-codegraph",
  "version": "1.0.0",
  "description": "CodeGraph — semantic code intelligence (MCP) for DeepSeek Harness. Adds codegraph_explore so agents answer structural code questions from a pre-built code graph.",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "codegraph",
    "code-graph",
    "code-intelligence",
    "mcp"
  ],
  "license": "MIT",
  "author": {
    "name": "dsh-codegraph contributors"
  },
  "homepage": "https://github.com/hilariouhiss/dsh-hiss-plugins/tree/main/dsh-codegraph",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hilariouhiss/dsh-hiss-plugins.git",
    "directory": "dsh-codegraph"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@deepseek-ai/dsh-mcp-client": "0.1.1-rc.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "test": "node --test",
    "prepublishOnly": "npm test"
  },
  "engines": {
    "node": ">=20"
  }
}
