{
  "name": "@hilariouhiss/dsh-openspec",
  "version": "1.0.1",
  "description": "OpenSpec — spec-driven development workflow ported to DeepSeek Harness (12 workflow skills + /opsx-* slash commands). Agree on what to build before any code is written.",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "openspec",
    "spec",
    "spec-driven-development",
    "skill",
    "workflow"
  ],
  "license": "MIT",
  "author": {
    "name": "dsh-openspec contributors"
  },
  "homepage": "https://github.com/hilariouhiss/dsh-hiss-plugins/tree/main/dsh-openspec",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hilariouhiss/dsh-hiss-plugins.git",
    "directory": "dsh-openspec"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
